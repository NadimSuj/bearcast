# Copy to .env (which git ignores) and adjust if needed.
# Homebrew Postgres: your Mac username, no password, on localhost.
DATABASE_URL=postgresql+psycopg://localhost:5432/bearcast
# A separate, throwaway database for the tests (they wipe it).
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/bearcast_test
# Deployed database (Neon). Paste the connection string Neon gives you, in quotes. Used for loading data and the
# monthly job, e.g.  python -m bearcast.db.load --url-var NEON_DATABASE_URL   (see docs/deploy.md)
# NEON_DATABASE_URL='postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require'
